rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthorized() {
      return isSignedIn() && (request.auth.token.email == 'alvitafabiola@gmail.com' || request.auth.token.email == 'shawtynewt@gmail.com' || request.auth.token.email == 'jessenreinharts@gmail.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidEntry(data) {
      return data.keys().hasAll(['title', 'content', 'mood', 'isPublic', 'createdAt', 'ownerId'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.content is string && data.content.size() > 0 && data.content.size() <= 200000
        && data.mood is string && data.mood.matches('^(Happy|Inspired|Cozy|Dreamy|Calm)$')
        && data.isPublic is bool
        && data.createdAt is number
        && data.ownerId is string && data.ownerId == request.auth.uid;
    }

    match /entries/{entryId} {
      // Read access: Public entries are readable by anyone. Private entries are readable only by the owner or authorized users.
      allow read: if isValidId(entryId) && (existing().isPublic == true || (isSignedIn() && (existing().ownerId == request.auth.uid || isAuthorized())));

      // Query list: The client must filter by isPublic == true if unauthenticated, or ownerId == uid, or if authorized.
      allow list: if resource.data.isPublic == true || (isSignedIn() && (resource.data.ownerId == request.auth.uid || isAuthorized()));

      // Create: user must be signed in & authorized, shape must be valid, no ghost fields allowed.
      allow create: if isAuthorized() 
        && isValidId(entryId)
        && isValidEntry(incoming())
        && incoming().keys().size() == 6;

      // Update: user must be signed in & authorized and owner, shape must be valid, ownerId must not change, createdAt must not change.
      allow update: if isAuthorized()
        && isValidId(entryId)
        && existing().ownerId == request.auth.uid
        && isValidEntry(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'mood', 'isPublic'])
        && incoming().keys().size() == 6;

      // Delete: Must be the owner or authorized
      allow delete: if isAuthorized()
        && isValidId(entryId)
        && existing().ownerId == request.auth.uid;
    }
  }
}

{
  "entities": {
    "JournalEntry": {
      "title": "Journal Entry",
      "description": "A single journal entry in the application",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "mood": { "type": "string", "enum": ["Happy", "Inspired", "Cozy", "Dreamy", "Calm"] },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "ownerId": { "type": "string", "description": "UID of the user who owns the entry" }
      },
      "required": ["title", "content", "mood", "isPublic", "createdAt", "ownerId"]
    }
  },
  "firestore": {
    "entries/{entryId}": {
      "schema": { "$ref": "#/entities/JournalEntry" },
      "description": "Collection of all journal entries"
    }
  }
}
